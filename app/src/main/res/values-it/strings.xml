    <string name="settings_dng_desc">Un file DNG accanto a ogni JPEG. Con il multi-frame attivo è il RAW fuso.</string>
    <string name="settings_timer_title">Autoscatto</string>
    <string name="settings_grid_desc">Linee dei terzi sul mirino.</string>
    <string name="group_viewfinder">strumenti del mirino</string>
    <string name="settings_tools_desc">Mostrano o nascondono soltanto ciò che la fotocamera misura; la misura che regola l\'esposizione del multi-frame resta sempre attiva.</string>
    <string name="settings_mf_title">Elaborazione multi-frame</string>
    <string name="settings_mf_desc">Più fotogrammi RAW fusi sulla GPU: meno rumore, più gamma dinamica, 20 MP da tutto il sensore. Qualche secondo per foto.</string>
    <string name="settings_mf_frames_title">Fotogrammi per foto</string>
    <string name="settings_mf_frames_desc">Auto sceglie in base alla luce e a quanto è fermo il telefono (fino a 12 quando è appoggiato).</string>
    <string name="group_look">aspetto</string>
    <string name="group_detail">rumore e dettaglio</string>
    <string name="settings_mf_vivid_desc">Più contrasto e saturazione.</string>
    <string name="settings_mf_tone_desc">Schiarisce le ombre e conserva cieli e finestre luminosi.</string>
    <string name="settings_mf_denoise_desc">Leviga il rumore rimasto dopo la fusione, conservando i bordi.</string>
    <string name="settings_mf_chroma_desc">Toglie le macchie colorate nelle zone scure.</string>
    <string name="settings_mf_sharpen_desc">Dettagli fini più netti.</string>
    <string name="settings_sound_desc">Clic allo scatto e all\'inizio e alla fine di una registrazione.</string>
    <string name="settings_gallery_title">Galleria</string>
    <string name="settings_gallery_desc">Si apre toccando la miniatura accanto al pulsante di scatto.</string>
    <string name="group_about">informazioni</string>
    <string name="about_desc">Fotocamera per il Lumia 950 XL con LineageOS. Software libero, GPL-3.0.</string>
    <string name="switch_on">Sì</string>
    <string name="switch_off">No</string>
    <string name="settings_accent">Colore d\'accento di sistema</string>
    <string name="settings_accent_desc">Usa il colore del tema di Android (dallo sfondo). Spento: ambra.</string>
    <string name="settings_level">Livella</string>
    <string name="settings_level_desc">Una linea dell\'orizzonte che prende il colore d\'accento quando la foto è dritta.</string>
    <string name="page_video">video</string>
    <string name="settings_timelapse">Time-lapse</string>
    <string name="settings_timelapse_desc">Tiene un fotogramma ogni 5, 10 o 30 e li riproduce a 30 fps, senza audio.</string>
    <string name="settings_stabilise">Stabilizzazione</string>
    <string name="settings_stabilise_desc">Sperimentale: rende più fermo il video con il giroscopio, ritagliando il 10 % dell\'inquadratura.</string>
    <string name="video_info">H.264 con audio AAC: 1080p a 20 Mbit/s con la posteriore, 720p con la frontale. Il badge AE blocca esposizione e bilanciamento del bianco.</string>
    <string name="settings_direct_video">Codifica diretta</string>
    <string name="settings_direct_video_desc">La fotocamera scrive direttamente nel codificatore video: più fluido e leggero. Se questa ROM non lo permette, torna da solo al metodo compatibile. Non si usa con time-lapse e stabilizzazione.</string>
    <string name="settings_direct_video_ok">Funziona su questa ROM: la fotocamera scrive direttamente nel codificatore video.</string>
    <string name="settings_direct_video_failed">Non ha funzionato su questa ROM, i video passano dalla GPU. Accendi per riprovare.</string>
