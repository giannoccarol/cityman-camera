    <string name="settings_format_title">Photo size</string>
    <string name="settings_dng_title">Also save RAW (DNG)</string>
    <string name="settings_dng_desc">A DNG file next to each JPEG. With multi-frame on, it is the merged RAW.</string>
    <string name="settings_timer_title">Self-timer</string>
    <string name="settings_grid_desc">Rule-of-thirds lines on the viewfinder.</string>
    <string name="group_viewfinder">viewfinder tools</string>
    <string name="settings_tools_desc">These only show or hide what the camera measures; the measurement that sets the multi-frame exposure always runs.</string>
    <string name="settings_mf_title">Multi-frame processing</string>
    <string name="settings_mf_desc">Several RAW frames merged on the GPU: less noise, more dynamic range, 20 MP from the whole sensor. A few seconds per photo.</string>
    <string name="settings_mf_off_raw">Not available: this camera does not deliver RAW frames.</string>
    <string name="settings_mf_off_manual">Not available: this camera has no manual exposure, which the burst needs.</string>
    <string name="settings_mf_off_gpu">Not available: the GPU has OpenGL ES %1$s, multi-frame needs 3.1 (compute shaders).</string>
    <string name="settings_mf_off_gpu_failed">Turned off: the GPU could not run the multi-frame shaders.</string>
    <string name="about_device">This camera: %1$s · OpenGL ES %2$s · Android %3$s</string>
    <string name="settings_mf_frames_title">Frames per photo</string>
    <string name="settings_mf_frames_desc">Auto picks from the light and from how still the phone is (up to 12 when it rests).</string>
    <string name="group_look">look</string>
    <string name="group_detail">noise and detail</string>
    <string name="settings_mf_vivid_desc">More contrast and saturation.</string>
    <string name="settings_mf_tone_desc">Brings out shadows and keeps bright skies and windows.</string>
    <string name="settings_mf_denoise_desc">Smooths the noise left after merging, keeping edges.</string>
    <string name="settings_mf_chroma_desc">Removes coloured blotches in dark areas.</string>
    <string name="settings_mf_sharpen_desc">Crisper fine detail.</string>
    <string name="settings_sound_desc">Click when taking a photo and when recording starts or stops.</string>
    <string name="settings_gallery_title">Gallery</string>
    <string name="settings_gallery_desc">Opened by the thumbnail next to the shutter button.</string>
    <string name="group_about">about</string>
    <string name="about_desc">Camera for the Lumia 950 XL running LineageOS. Free software, GPL-3.0.</string>
    <string name="switch_on">On</string>
    <string name="switch_off">Off</string>
    <string name="settings_accent">System accent colour</string>
    <string name="settings_accent_desc">Use the colour of Android\'s theme (from the wallpaper). Off: amber.</string>
    <string name="settings_level">Level</string>
    <string name="settings_level_desc">A horizon line that turns to the accent colour when the photo is straight.</string>
    <string name="page_video">video</string>
    <string name="settings_timelapse">Time-lapse</string>
    <string name="settings_timelapse_desc">Keeps one frame in 5, 10 or 30 and plays them at 30 fps, without sound.</string>
    <string name="settings_stabilise">Stabilisation</string>
    <string name="settings_stabilise_desc">Experimental: steadies the video with the gyroscope, cropping 10 % of the frame.</string>
    <string name="video_info">H.264 with AAC sound: 1080p at 20 Mbit/s on the rear camera, 720p on the front. The AE badge locks exposure and white balance.</string>
    <string name="settings_direct_video">Direct encoder</string>
    <string name="settings_direct_video_desc">The camera writes straight into the video encoder: smoother and lighter. Falls back by itself if this ROM refuses it. Not used with time-lapse or stabilisation.</string>
    <string name="settings_direct_video_ok">Works on this ROM: the camera writes straight into the video encoder.</string>
    <string name="settings_direct_video_failed">Did not work on this ROM, videos go through the GPU. Turn on to try again.</string>
